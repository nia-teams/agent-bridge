{
  "name": "@nia-teams/doubao-bridge",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "nia-doubao": "bin/nia-doubao.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README_CN.md",
    "skills",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@nia-teams/agent-bridge-core": "0.1.1",
    "doubao-cli": "0.23.3"
  },
  "author": "Nia Teams",
  "homepage": "https://nia-teams.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nia-teams/agent-bridge.git",
    "directory": "packages/doubao"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "description": "Connect Doubao CLI to Nia Teams group chats through its desktop-authenticated runtime"
}
