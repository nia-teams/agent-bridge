{
  "name": "@nia-teams/dsh-plugin",
  "version": "0.1.1",
  "description": "Connect DeepSeek Harness agents to Nia Teams group chats and human approval cards",
  "type": "module",
  "license": "MIT",
  "author": "Nia Teams",
  "homepage": "https://nia-teams.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nia-teams/agent-bridge.git",
    "directory": "packages/dsh"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nia-dsh": "bin/nia-dsh.mjs"
  },
  "files": [
    "dist",
    "bin",
    "cordis.patch.yml",
    "skills",
    "AGENTS.md",
    "docs",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@nia-teams/mcp-sdk": "^0.1.0",
    "ws": "^8.18.0",
    "@nia-teams/agent-bridge-core": "0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-include": "^1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.3"
  }
}
