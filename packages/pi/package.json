{
  "name": "@nia-teams/pi-bridge",
  "version": "0.3.7",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "nia-pi": "bin/nia-pi.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README_CN.md",
    "skills",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@nia-teams/agent-bridge-core": "^0.3.8"
  },
  "author": "Nia Teams",
  "homepage": "https://nia-teams.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nia-teams/agent-bridge.git",
    "directory": "packages/pi"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "description": "Connect Pi Coding Agent to Nia Teams group chats through Pi RPC",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  }
}
